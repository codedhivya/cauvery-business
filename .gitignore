# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Dependency directories
node_modules/
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Packaged skill build artifacts — regenerable from sector-financial-analysis/
# via the skill-creator packaging script. Distribute via GitHub Releases.
*.skill

# ...but keep the archived originals: archive/ is the rollback point for the
# 9 insurance skills this repo replaced, so their packaged versions stay tracked.
!archive/**/*.skill

# Python
__pycache__/
*.pyc
venv/
.venv/

# NOTE: reports/staging/ is deliberately NOT ignored. Draft reports are tracked
# so review history is visible; promotion to reports/published/ is a manual step.
